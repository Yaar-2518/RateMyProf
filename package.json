{
  "name": "rate-my-prof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:init": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "admin:create": "node server/scripts/create-admin.js",
    "setup:local": "node server/scripts/setup-local.js",
    "test": "node --test server/tests/unit.test.js server/tests/catalog.test.js server/tests/intelligence.test.js src/tests/search-select.test.js",
    "test:integration": "node --test --test-concurrency=1 server/tests/integration.test.js server/tests/queue.integration.test.js",
    "catalog:collect": "node server/scripts/collect-nitw.js",
    "catalog:sync": "node server/scripts/import-nitw.js",
    "dev:all": "node server/scripts/dev-all.js",
    "dev:worker": "node --watch server/workers/intelligence.js",
    "worker": "node server/workers/intelligence.js",
    "check:connections": "node server/scripts/check-connections.js",
    "test:ui": "node --test src/tests/search-select.test.js"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "google-auth-library": "^9.14.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "mongodb": "^6.12.0",
    "nodemailer": "^10.0.16",
    "rate-limit-redis": "^6.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "vite": "^7.1.0"
  }
}
